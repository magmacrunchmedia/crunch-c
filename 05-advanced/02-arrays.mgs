// Module 05, Exercise 02: Fixed-Size Arrays
//
// In C, you can have fixed-size arrays in structs:
//   struct Buffer {
//       int data[16];
//       int length;
//   };
//
// In crunch-c, you declare array fields with [count]:
//   floorplan Buffer {
//       data: i32[16]
//       length: i32
//   }

// Define a buffer that holds 4 i32 values.
floorplan Buffer {
    data: i32[4]
    length: i32
}

// Create and populate a buffer.
buf = garrison(sizeof(Buffer))
buf.poke(Buffer.length, i32(0))

// Write values using pointer arithmetic.
i = 0
while i < 4 {
    offset = i * 4  // each i32 is 4 bytes
    (buf + offset).poke(i32, (i + 1) * 10)
    i = i + 1
}

// The length field is at a fixed offset determined by the floorplan.
// For this layout, data is 16 bytes, so length is at offset 16.
buf.poke(Buffer.length, i32(4))

// Read them back.
len = buf.peek(Buffer.length)
print(f"buffer has {len} elements")

i = 0
while i < len {
    offset = i * 4
    val = (buf + offset).peek(i32)
    print(f"data[{i}] = {val}")
    i = i + 1
}

// YOUR TASK:
// 1. Run this file. Does it print the values correctly?
// 2. Create a floorplan "Matrix" with a 3x3 grid of i32 values.
// 3. Write values to fill the matrix.
// 4. What happens if you write past the array bounds?
