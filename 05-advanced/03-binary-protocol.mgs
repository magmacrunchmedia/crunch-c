// Module 05, Exercise 03: Binary Protocol Parsing
//
// In C, network protocols and file formats are often binary:
// a header with fixed fields, followed by variable-length data.
//
// This exercise parses a simple binary protocol:
//   - 2 bytes: magic number (0x4D47 = "MG")
//   - 1 byte: version
//   - 1 byte: flags
//   - 4 bytes: payload length
//   - N bytes: payload

floorplan PacketHeader {
    magic: u16
    version: u8
    flags: u8
    payload_len: u32
}

// Simulate a packet in memory.
data = garrison(12)

// Write the header.
data.poke(PacketHeader.magic, u16(0x4D47))   // "MG"
data.poke(PacketHeader.version, u8(1))
data.poke(PacketHeader.flags, u8(0x0F))
data.poke(PacketHeader.payload_len, u32(4))

// Show the layout.
layout(PacketHeader)
print(f"header size: {sizeof(PacketHeader)}")

// Parse the header back.
magic = data.peek(PacketHeader.magic)
version = data.peek(PacketHeader.version)
flags = data.peek(PacketHeader.flags)
payload_len = data.peek(PacketHeader.payload_len)

print(f"magic: 0x{magic}")
print(f"version: {version}")
print(f"flags: 0x{flags}")
print(f"payload length: {payload_len}")

// YOUR TASK:
// 1. Run this file. Does the round-trip work?
// 2. Add a "checksum" field (u8) to the header.
// 3. What's the total header size with the checksum?
// 4. Create a floorplan for a more complex protocol:
//    - 4 bytes: magic ("TEST")
//    - 2 bytes: message type
//    - 2 bytes: sequence number
//    - 4 bytes: timestamp
//    - 2 bytes: data length
//    - N bytes: data

// BONUS: Use bathysphere() to dump the raw bytes
// of the packet. Can you spot the header fields?
