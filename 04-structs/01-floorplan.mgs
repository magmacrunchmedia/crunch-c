// Module 04, Exercise 01: Defining Structs
//
// In C, you define a struct like this:
//   struct Point {
//       int x;
//       int y;
//   };
//
// In crunch-c, you use floorplan:
//   floorplan Point {
//       x: i32
//       y: i32
//   }

// Define a struct.
floorplan Point {
    x: i32
    y: i32
}

// Create an instance. Pass the floorplan to garrison() — not a byte count.
// The pine then knows what it points at, so fields have names instead of
// offsets, the way p->x does in C.
p = garrison(Point)
p.x = i32(10)
p.y = i32(20)

print(f"point: ({p.x}, {p.y})")

scorch(p)

// YOUR TASK:
// 1. Run this file. What does it print?
// 2. Define a floorplan called "Person" with fields:
//    - name: u8[16]  (a fixed-size string)
//    - age: u8
// 3. Create a Person and set its age to 25.

floorplan Person {
    name: u8[16]
    age: u8
}

person = garrison(Person)
person.age = u8(25)
print(f"person age: {person.age}")

scorch(person)
